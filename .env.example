# Anciennes installations seulement. La version actuelle configure les bilans
# depuis l'interface et utilise le service FluentFlow : aucune clé locale requise.
# La clé commune doit rester dans les variables privées du serveur FluentFlow.
# Compatibilité avec les anciens rapports directs Resend :
RESEND_API_KEY=

# Destinataire des rapports. Sans domaine vérifié dans Resend, seule
# l'adresse de ton compte Resend peut recevoir les e-mails.
NOTIFY_EMAIL=

# Optionnel : expéditeur sur un domaine vérifié, ex. "LinkedIn auto <bot@ton-domaine.fr>"
RESEND_FROM=
